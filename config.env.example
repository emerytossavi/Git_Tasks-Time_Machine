# Git Tasks-Time Machine (GTM) - Configuration modèle
# Ce fichier sert de modèle de configuration publique partagée par le dépôt.
# Pour personnaliser vos paramètres locaux (modèle, langue, hôte privé),
# copiez ce fichier vers 'config.env' (ignoré par Git) ou utilisez les commandes CLI :
#   gtm model <nom>
#   gtm lang <code_lang>
#   gtm config host <url>

REPO_URL="https://github.com/emerytossavi/Git_Tasks-Time_Machine.git"
REPO_BRANCH="main"
RAW_FILE_URL="https://raw.githubusercontent.com/emerytossavi/Git_Tasks-Time_Machine/main/gtm.sh"

# Modèle SLM local par défaut pour 'gtm plan'
DEFAULT_MODEL="qwen2.5-coder:1.5b"

# Hôte / URL du démon Ollama (défaut: http://localhost:11434)
# Permet de cibler une machine distante, un serveur GPU sur le réseau local ou un port sécurisé
OLLAMA_HOST="http://localhost:11434"

# Langue des messages de commit générés (défaut: en)
# Note : Les mots-clés Conventional Commits (feat, fix, docs, etc.) restent toujours en anglais standardisé.
DEFAULT_LANG="en"

# Timeout d'inférence en secondes pour le SLM Ollama (défaut: 180)
OLLAMA_TIMEOUT="180"
